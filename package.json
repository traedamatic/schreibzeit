{
  "name": "schreibzeit",
  "version": "1.0.0",
  "private": true,
  "description": "Schreibzeit – Lernwörter-Kartei, Knickblätter und KI-Übungstexte für Grundschullehrkräfte (local-first, offline, PWA + Desktop).",
  "keywords": [
    "education",
    "edtech",
    "teachers",
    "primary-school",
    "spelling",
    "worksheet-generator",
    "german",
    "pwa",
    "local-first",
    "offline-first",
    "gdpr",
    "typescript",
    "react",
    "ai",
    "lernwoerter",
    "grundschule",
    "knickblatt",
    "rechtschreibung"
  ],
  "author": "Schreibzeit",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "./",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build:electron": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis portable",
    "build:mac": "npm run build && electron-builder --mac dmg",
    "build:linux": "npm run build && electron-builder --linux AppImage",
    "dev:full": "./scripts/dev.sh"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "hyphen": "^1.14.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "de.schreibzeit.app",
    "productName": "Schreibzeit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "dmg": {
      "artifactName": "Schreibzeit-${version}.dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Schreibzeit-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Schreibzeit-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "Schreibzeit-${version}.AppImage"
    }
  }
}
